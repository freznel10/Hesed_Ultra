{
  "name": "hesed-ultra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx db/seed.ts",
    "art:places": "python3 tools/gen_places.py",
    "art:characters": "python3 tools/prep_characters.py && python3 tools/prep_sheet.py",
    "art:sync": "mkdir -p public/sprites/portraits && cp assets/places/*.png assets/characters/*_front.png assets/characters/*_walk.png assets/characters/walk.json public/sprites/ && cp assets/characters/portraits/*.png public/sprites/portraits/",
    "dev:netlify": "netlify dev",
    "export": "tsx db/backup.ts export",
    "import": "tsx db/backup.ts import"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "netlify-cli": "^27.16.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
