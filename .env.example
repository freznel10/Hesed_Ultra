# Local use needs none of these: data is stored in ./.data/pglite and nobody needs a PIN.

# Optional: where the local database folder lives.
# PGLITE_DIR=./.data/pglite

# Optional: which family member a local agent (Claude) acts as. Default: freznel.
# HESED_MCP_MEMBER=diane

# --- Online only (set these in Netlify's environment variables, never in git) ---
# Long random text used to sign login cookies. Required online; the site locks itself without it.
# SESSION_SECRET=
# One-time code (8+ characters) a parent uses to sign in before any PIN exists.
# SETUP_CODE=
# Postgres connection string. Netlify DB sets NETLIFY_DATABASE_URL for you.
# DATABASE_URL=
